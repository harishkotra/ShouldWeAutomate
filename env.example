# LM Studio (or OpenAI-compatible) configuration for AI enrichment
# The deterministic scoring engine works without these.
# Set these only if you want AI-powered features:
#   - Pre-fill scores from workflow descriptions
#   - Contextual risk analysis
#   - Executive summaries

LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-e4b
# LLM_API_KEY=sk-...  # Only needed for cloud endpoints (OpenAI, etc.)
